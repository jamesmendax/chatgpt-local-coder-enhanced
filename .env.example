PORT=3000
HOST=127.0.0.1

# REQUIRED for any remotely exposed MCP endpoint. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_TOKEN=

# Default project directory for relative paths, shell, and git operations.
WORKSPACE_PATH=C:\Users\YourName\projects\my-app
# EXTRA_WORKSPACE_PATHS=D:\Projects\another-repo

# slim = smaller ChatGPT tool list; full = every registered native tool.
CHATGPT_TOOL_PROFILE=slim

# Browser-origin policy. Server-to-server requests without Origin are still allowed.
# MCP_CORS_ORIGINS=https://chatgpt.com,https://chat.openai.com

# JSON request limit. 16mb supports the binary tool hard maximum, while ChatGPT
# clients should normally send much smaller chunks (64-256 KiB recommended).
MCP_JSON_LIMIT=16mb

# Optional post-edit hooks.
# POST_EDIT_HOOKS_CONFIG=profiles/post-edit-hooks.json

# Persistent shell state.
# MCP_SHELL_STATE_DIR=.mcp-state
SHELL_TIMEOUT=120

# Project-memory injection limits.
# PROJECT_MEMORY_MAX_BYTES=25000
# PROJECT_MEMORY_MAX_LINES=200

# Tool annotations used to reduce repetitive confirmations in ChatGPT.
CHATGPT_AUTO_APPROVE=true

# Local audit log.
AUDIT_LOG_PATH=.mcp-audit.log

# Checkpoint / rewind.
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=.mcp-checkpoints
CHECKPOINT_MAX_COUNT=500
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_MAX_FILE_BYTES=5242880

# Admin UI/API. Keep this on localhost and do not tunnel it.
ADMIN_PORT=3001
ADMIN_TOKEN=

# Optional upstream MCP hub configuration.
MCP_UPSTREAM_CONFIG=profiles/mcp-upstream.json

# MCP session recovery.
MCP_SESSION_RECOVERY=true
MCP_SESSION_TTL_MS=86400000
MCP_SESSION_CLEANUP_MS=300000
MCP_SESSION_DELETE_GRACE_MS=45000

# Primary OpenAI Secure MCP Tunnel (for example a Free/Personal workspace).
# Store the Runtime API key with save-free-key.cmd on Windows whenever possible.
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_HEALTH_PORT=8080
# Compatibility fallback only. Prefer the DPAPI key file instead of plaintext .env.
OPENAI_TUNNEL_API_KEY=

# Optional second tunnel (for example a ChatGPT Business workspace).
# The Runtime API key is stored with save-business-key.cmd, not in .env.
OPENAI_BUSINESS_TUNNEL_ID=
OPENAI_BUSINESS_TUNNEL_HEALTH_PORT=8081
